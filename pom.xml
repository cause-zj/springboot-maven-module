<?xml version="1.0" encoding="UTF-8"?>
<!--
  单模块 Maven 工程：Spring Boot 3.5.16，编译目标 JDK 21。
  父 POM 负责依赖与插件的版本对齐，本文件只声明本工程需要的依赖和打包插件。

  常用命令（在本文件所在目录执行）：
    mvn test                  只跑 src/test/java 下的测试
    mvn -DskipTests package   编译并打可执行 jar，跳过测试
    mvn spring-boot:run       不先打 jar，直接启动应用（端口见 application.yml，默认 8080）
    java -jar target/springboot-maven-module-0.0.1-SNAPSHOT.jar
                              运行 package 产出的可执行 jar
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- POM 模型版本。Maven 3 固定为 4.0.0，与 Spring Boot 版本无关。 -->
    <modelVersion>4.0.0</modelVersion>

    <!--
      继承 Spring Boot 父工程。作用：
      1. 通过 BOM 锁定 Spring 生态依赖版本，下面未写 version 的依赖由此解析；
      2. 约定 java.version、资源过滤、测试插件等构建默认值；
      3. 在 pluginManagement 中提供 spring-boot-maven-plugin 的版本。
      relativePath 置空：不到上级目录找父 POM，一律从 Maven 仓库下载。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!--
      本工程坐标，三者共同唯一标识构建产物。
      默认 jar 名为 ${artifactId}-${version}.jar，即 springboot-maven-module-0.0.1-SNAPSHOT.jar。
      SNAPSHOT 表示开发中的非正式版本，每次构建都会覆盖本地仓库里的同名产物。
    -->
    <groupId>com.cause</groupId>
    <artifactId>springboot-maven-module</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>springboot-maven-module</name>
    <description>Spring Boot sample with web, MyBatis-Plus, and MySQL</description>

    <!--
      可被 ${属性名} 引用的构建参数。
      java.version：父 POM 把它传给 maven-compiler-plugin 的 release，这里编译、运行都要求 JDK 21。
      mybatis-plus.version：本工程自定义。MyBatis-Plus 不在 Spring Boot BOM 里，版本必须自己指定。
    -->
    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
    </properties>

    <!--
      依赖列表。未写 version 的条目由 spring-boot-starter-parent 的依赖管理提供版本。
      scope 决定依赖何时进入 classpath、会不会打进最终 jar：
      缺省 compile：编译、测试、运行都需要，并打进可执行 jar；
      runtime：编译用不到，运行和打包需要；
      test：仅 mvn test 使用，不进入可执行 jar。
    -->
    <dependencies>
        <!--
          Web 起步依赖：Spring MVC、Jackson、内嵌 Tomcat 及校验、日志等传递依赖。
          用来暴露 REST 接口，例如 GET /api/ping、GET /api/health、GET /api/test-data。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          MyBatis-Plus 的 Spring Boot 3 starter。提供 Mapper 扫描、通用 CRUD 与下划线转驼峰等自动配置。
          配合 Application 上的 @MapperScan("com.cause.dao") 注册 dao 包中的 Mapper。
          版本不由 Boot 管理，所以用上面的 mybatis-plus.version。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!--
          MySQL 8 JDBC 驱动（制品名 mysql-connector-j）。
          scope 为 runtime：业务代码不直接调用驱动 API，只在运行时由 Spring 按 application.yml 里的
          driver-class-name 加载，用于连接 jdbc:mysql://localhost:3306/app。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
          测试起步依赖：JUnit 5、AssertJ、Mockito、Spring Test、spring-boot-test。
          scope 为 test，只服务 src/test/java，例如 TestDataAppServiceTest。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      构建插件。这里只显式声明 Spring Boot 打包插件；编译、资源、surefire 等由父 POM 继承得到。
      未写 version：版本与父工程的 Spring Boot 版本一致，避免插件和框架错位。
    -->
    <build>
        <plugins>
            <!--
              在 package 阶段把普通 jar 重打包为可执行 fat jar：依赖打进 BOOT-INF，
              启动类为 com.cause.Application（插件会查找唯一的 main 方法）。
              也提供 spring-boot:run，用于本地直接启动，无需先 java -jar。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
